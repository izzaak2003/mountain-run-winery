---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { events, links } from '../data/site';
import barn from '../assets/corn-crib.jpg';
import farm from '../assets/farm.jpg';
import bottles from '../assets/tasting-room.jpg';
---

<BaseLayout title="Mountain Run Winery — Unofficial Portfolio Demo" description="An unofficial portfolio concept for Mountain Run Winery in Culpeper, Virginia, with its corn-crib tasting room and farm events.">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span> A Virginia farm winery</p>
        <h1 id="hero-title">Wine tastes<br />better in a<br /><em>corn crib.</em></h1>
        <p class="hero-intro">The slatted walls still let the breeze through. Now there’s Virginia wine inside. Find the tasting barn just outside downtown Culpeper.</p>
        <div class="hero-actions"><a class="button" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a><a class="text-link" href="#events">What’s happening <span aria-hidden="true">↓</span></a></div>
        <p class="hero-footnote">10753 Mountain Run Lake Road · Culpeper, VA</p>
      </div>
      <figure class="hero-photo">
        <Image src={barn} alt="Mountain Run Winery’s weathered wooden tasting barn, framed by pine trees" widths={[480, 800, 1200, 1500]} sizes="(max-width: 760px) 100vw, 55vw" format="webp" loading="eager" fetchpriority="high" />
        <figcaption><span>The corn-crib tasting room.</span><span>Culpeper, Virginia <span aria-hidden="true">↗</span></span></figcaption>

      </figure>
    </section>
    <div class="welcome-strip" aria-label="At a glance"><div class="wrap"><span>Culpeper, Virginia</span><span>Corn-crib tasting room</span><span>Picnics welcome</span><span>Leashed dogs welcome</span></div></div>
    <section class="events-section wrap section-space" id="events" aria-labelledby="events-title">
      <div class="section-heading"><div><p class="eyebrow">September & October 2026</p><h2 id="events-title">Fall at <em>Mountain Run.</em></h2></div><a class="text-link" href={links.events}>Official event calendar <span aria-hidden="true">↗</span></a></div>
      <div class="event-list">{events.map((event) => (
        <article class="event-row">
          <time class="event-date" datetime={event.date}><span>{event.month}</span><strong>{event.day}</strong><span>2026</span></time>
          <div class="event-content"><p class="event-meta">{event.category}<span aria-hidden="true"> / </span>{event.time}</p><h3><a href={event.url}>{event.name}</a></h3><p>{event.description}</p></div>
          <a class="event-arrow" href={event.url} aria-label={`Official details for ${event.name}`}><span aria-hidden="true">↗</span></a>
        </article>
      ))}</div>
      <p class="source-note">Calendar snapshot · September 2026. Check official listings for current details and tickets.</p>
    </section>
    <section class="farm-section" id="our-farm" aria-labelledby="farm-title"><div class="wrap farm-grid section-space">
      <figure class="farm-photo"><Image src={farm} alt="An aerial view of the winery’s three barns, surrounded by green fields and woodland" widths={[480, 800, 1200, 1437]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy" /><figcaption>The barns and surrounding fields, seen from above.</figcaption></figure>
      <div class="farm-copy"><p class="eyebrow">From tractor bays to tasting room</p><h2 id="farm-title">The farm came<br /><em>first.</em></h2><p>Those open bays once sheltered tractors and hay wagons. The corn crib stored feed. When Mountain Run opened as a winery in 2016, the barns stayed at the heart of the place.</p><p>Today the tasting room looks out onto 36 acres of fields and woodland, with Mountain Run creek along the back of the property.</p><a class="text-link" href="/visit/">Visit the tasting barn <span aria-hidden="true">↗</span></a></div>
    </div></section>
    <section class="wine-section wrap section-space" id="wines" aria-labelledby="wine-title">
      <div class="wine-copy"><p class="eyebrow">From the wine list</p><h2 id="wine-title">Around here,<br />it’s <em>“Vinny.”</em></h2><p>That’s the winery’s nickname for Viognier: a floral white with peach and honeysuckle on the nose. No pronunciation test required.</p><div class="wine-links"><a class="button" href="/wines/">Meet the wines <span aria-hidden="true">↗</span></a><a class="text-link" href={links.shop}>Shop on Vinoshipper <span aria-hidden="true">↗</span></a></div><p class="source-note">Wine selection and availability on the official site.</p></div>
      <figure class="wine-photo"><Image src={bottles} alt="A bottle of Mountain Run Meritage beside a wine rack in the sunlit tasting room" widths={[480, 800, 1200, 1500]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy" /><figcaption>Meritage in the tasting room.</figcaption></figure>
    </section>
    <section class="visit-section" id="visit" aria-labelledby="visit-title"><div class="wrap visit-grid section-space">
      <div><p class="eyebrow">Out to the farm</p><h2 id="visit-title">Pack a picnic.<br /><em>Find the barn.</em></h2><p>A tasting flight is a good place to begin. Check the seasonal hours and practical details before you head out.</p><a class="button button-light" href="/visit/">Plan your visit <span aria-hidden="true">↗</span></a></div>
      <div class="visit-details"><div><p class="eyebrow">Find the farm</p><address>10753 Mountain Run Lake Road<br />Culpeper, Virginia 22701</address><a class="text-link" href={links.directions}>Get directions <span aria-hidden="true">↗</span></a></div><div><p class="eyebrow">Weddings at Mountain Run</p><p>See the barn venue and ask the winery about available dates.</p><a class="text-link" href={links.weddings}>Weddings at the winery <span aria-hidden="true">↗</span></a></div><p class="visit-note">Hours vary by season. Confirm hours, accessibility arrangements, and group visits with the winery before heading out.</p></div>
    </div></section>
</BaseLayout>
